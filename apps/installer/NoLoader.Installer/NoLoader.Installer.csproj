<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AssemblyName>NoLoader</AssemblyName>
    <RootNamespace>NoLoader.Installer</RootNamespace>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <NoLoaderDistributionBuild Condition="'$(NoLoaderDistributionBuild)' == ''">false</NoLoaderDistributionBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NoLoader.Installer.Core\NoLoader.Installer.Core.csproj" />
  </ItemGroup>
  <Target Name="GeneratePinnedReleaseConfiguration" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\scripts\generate-release-config.mjs&quot; &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)NoLoaderReleaseConfiguration.g.cs&quot; &quot;$(NoLoaderDistributionBuild)&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)NoLoaderReleaseConfiguration.g.cs" />
    </ItemGroup>
  </Target>
</Project>
