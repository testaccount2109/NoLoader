<Window x:Class="NoLoader.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoLoader Installer" Width="720" Height="570" MinWidth="660" MinHeight="530"
        WindowStartupLocation="CenterScreen" Background="#050505"
        Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="14"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#050505" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0A0A0A" />
        <SolidColorBrush x:Key="InputBrush" Color="#080808" />
        <SolidColorBrush x:Key="EdgeBrush" Color="#262626" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#A3A3A3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#737373" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#050505" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="HoverBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#E5E5E5" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource SecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeinstallButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        </Style>

        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#3D3D3D" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NoLoader" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="NoRisk Launcher installer" Margin="0,3,0,0"
                           Foreground="{StaticResource SecondaryBrush}" FontSize="12" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh"
                    Style="{StaticResource QuietButtonStyle}" MinHeight="36" Padding="14,5"
                    Click="RefreshButton_Click" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="LATEST RELEASE" Foreground="{StaticResource MutedBrush}"
                       FontSize="10" FontWeight="SemiBold" />
            <TextBlock x:Name="LatestVersionText" Text="No release checked" Margin="0,7,0,0"
                       FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="CatalogStateText" Text="Checking signed catalog…" Margin="0,5,0,0"
                       Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="ChannelVersionsText" Text="Stable —   ·   Beta —" Margin="0,14,0,0"
                       Foreground="{StaticResource SecondaryBrush}" FontSize="12" />
            <TextBlock x:Name="ComponentVersionsText" Text="Core —   ·   Mod API —" Margin="0,4,0,0"
                       Foreground="{StaticResource SecondaryBrush}" FontSize="12" />
            <TextBlock x:Name="CommitText" Text="Commit —" Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock x:Name="CatalogValidityText" Text="Catalog —" Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" />
        </StackPanel>

        <Border Grid.Row="4" Height="1" Background="{StaticResource EdgeBrush}" />

        <StackPanel Grid.Row="6">
            <TextBlock Text="INSTALL LOCATION" Foreground="{StaticResource MutedBrush}"
                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="102" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InstallPathTextBox" Grid.Column="0" Style="{StaticResource PathTextBoxStyle}"
                         TextChanged="InstallPathTextBox_TextChanged" LostFocus="InstallPathTextBox_LostFocus" />
                <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse"
                        Style="{StaticResource ActionButtonStyle}" Click="BrowseButton_Click" />
            </Grid>
            <TextBlock x:Name="TargetStateText" Text="Select the folder used by your NoRisk shortcut."
                       Margin="1,7,0,0" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="ProgressStatusText" Text="Ready" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="ProgressDetailText" Text="Check GitHub to load available launcher versions."
                           Margin="0,4,0,0" Foreground="{StaticResource SecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" />
                <ProgressBar x:Name="MainProgressBar" Height="3" Margin="0,10,0,0" Minimum="0" Maximum="100"
                             Background="{StaticResource EdgeBrush}" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Visibility="Collapsed" IsEnabled="False"
                    Style="{StaticResource QuietButtonStyle}" Padding="12,6" Margin="16,0,0,0"
                    Click="CancelButton_Click" />
        </Grid>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PatchButton" Grid.Column="0" Content="Patch NoRisk Launcher"
                    Style="{StaticResource PrimaryButtonStyle}" Click="PatchButton_Click" IsEnabled="False" />
            <Button x:Name="UpdateButton" Grid.Column="2" Content="Update NoLoader"
                    Style="{StaticResource ActionButtonStyle}" Click="UpdateButton_Click" IsEnabled="False" />
            <Button x:Name="DeinstallButton" Grid.Column="4" Content="Deinstall NoLoader"
                    Style="{StaticResource DeinstallButtonStyle}" Click="DeinstallButton_Click" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
