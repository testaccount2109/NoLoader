<Window x:Class="NoLoader.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoLoader Installer" Width="620" Height="520" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="NoLoader Installer" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Replace the selected NoRisk Launcher program files with a signed NoLoader build." Margin="0,4,0,16" TextWrapping="Wrap" />
            <TextBlock Text="Unofficial community build; not affiliated with or endorsed by NoRisk Client." Margin="0,-10,0,12" FontSize="11" TextWrapping="Wrap" />

            <GroupBox Header="Release" Padding="10">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="RefreshButton" Content="Check releases" Padding="8,4" DockPanel.Dock="Right" Click="RefreshButton_Click" />
                        <ComboBox x:Name="ChannelComboBox" SelectedIndex="0" SelectionChanged="ChannelComboBox_SelectionChanged" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Stable" Tag="stable" />
                            <ComboBoxItem Content="Beta" Tag="beta" />
                        </ComboBox>
                    </DockPanel>
                    <TextBlock x:Name="ReleaseVersionText" Text="Waiting for a verified release" Margin="0,10,0,0" FontWeight="Bold" />
                    <TextBlock x:Name="ChannelBadgeText" Visibility="Collapsed" />
                    <TextBlock x:Name="ReleaseSubtext" Text="Release information is verified before files are changed." Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Core " /><Run x:Name="CoreVersionText" Text="—" />
                        <Run Text="   API " /><Run x:Name="ApiVersionText" Text="—" />
                        <Run Text="   Commit " /><Run x:Name="CommitText" Text="—" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Existing NoRisk Launcher folder" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="BrowseButton" Content="Browse" Padding="8,4" Margin="8,0,0,0" DockPanel.Dock="Right" Click="BrowseButton_Click" />
                        <TextBox x:Name="InstallPathTextBox" VerticalContentAlignment="Center" TextChanged="InstallPathTextBox_TextChanged" LostFocus="InstallPathTextBox_LostFocus" />
                    </DockPanel>
                    <TextBlock Text="Select the folder used by your normal NoRisk shortcut. The old program folder is kept beside it as a backup." Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <Border x:Name="NoticeBanner" BorderThickness="1" Padding="8" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Border x:Name="NoticeMarker" Width="4" Margin="0,0,8,0" DockPanel.Dock="Left" />
                    <StackPanel>
                        <TextBlock x:Name="NoticeTitle" FontWeight="Bold" />
                        <TextBlock x:Name="NoticeBody" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock x:Name="ProgressStatusText" Text="Waiting for signed release details" Margin="0,14,0,0" FontWeight="Bold" />
            <TextBlock x:Name="ProgressDetailText" Text="No files have been changed." Margin="0,3,0,0" TextWrapping="Wrap" />
            <ProgressBar x:Name="MainProgressBar" Height="14" Margin="0,8,0,0" Minimum="0" Maximum="100" />

            <DockPanel Margin="0,14,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="UninstallButton" Content="Remove NoLoader files" Padding="8,5" Click="UninstallButton_Click" IsEnabled="False" />
                    <Button x:Name="RestoreOriginalButton" Content="Restore original NoRisk" Padding="8,5" Margin="8,0,0,0" Click="RestoreOriginalButton_Click" IsEnabled="False" />
                    <Button x:Name="LaunchButton" Content="Open launcher" Padding="8,5" Margin="8,0,0,0" Click="LaunchButton_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Padding="8,5" Margin="0,0,8,0" Click="CancelButton_Click" IsEnabled="False" />
                    <Button x:Name="InstallButton" Content="Install NoLoader" Padding="10,5" Click="InstallButton_Click" IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
